# ================= PRODUCCIÓN (lo que va en Netlify) =================
VITE_API_SALES=https://ec-sales.makipos.la
VITE_API_PRODUCTS=https://ec-products.makipos.la
VITE_ENABLE_ORDER=1

# Lista de precios (vacío = usa product.price)
VITE_PRICE_LIST_ID=

# Dominio con el que se consulta el comercio. UN valor para TODOS los menús.
#  - Déjalo VACÍO cuando los comercios ya estén registrados con el dominio
#    del menú (ej. https://menu.makipos.la/c/<slug>).
#  - Ponlo mientras sigan registrados con el dominio del catálogo:
VITE_RESOLVE_DOMAIN_BASE=https://catalogos.makipos.la

# ================= SOLO DESARROLLO (se ignora en el build) ============
# Menú que abre http://localhost:5173 cuando no pones /c/<slug>
VITE_DEV_SLUG=radiador
